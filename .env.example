# Copy to .env for local development: cp .env.example .env
# .env is git-ignored. Never commit real keys. On a host (Render), set these as environment variables instead.
# Environment variables set on the host take priority over .env.

# ---- Required for live runs ----
# Qloo Insights API (hackathon key)
QLOO_API_KEY=
# Model host for GPT-6 Astra: comet (CometAPI, pay as you go) or kie (prepaid credits)
LLM_PROVIDER=comet
# Key for the provider chosen above
COMET_API_KEY=
KIE_API_KEY=

# ---- Required by the build step (python build_data.py) ----
# US Census API, for neighbourhood profiles
CENSUS_API_KEY=

# ---- Optional: model ----
# Model name sent to the provider
LLM_MODEL=gpt-6-astra
# Seconds before a slow model call is hedged with a second request
LLM_HEDGE_AFTER=45
# Outage fallback (Azure OpenAI v1 Responses API), used only when the primary call fails
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# ---- Optional: live-run limits ----
# DAILY_CREDITS is a token-based estimate in Kie units; on CometAPI one unit is about $0.0142, so 600 is about $8.50 a day
DAILY_CREDITS=600
RUNS_PER_HOUR=4
ASKS_PER_HOUR=15
# The two Qloo lookups on the page (no model call)
LOOKUPS_PER_HOUR=30
# Live "ask the model" duels (two short model calls each)
DUELS_PER_HOUR=10
# Live runs at once
MAX_CONCURRENT=3
# Qloo calls kept in reserve each month; below this, uncached Qloo calls stop
QLOO_RESERVE=300

# ---- Optional: storage ----
# Where the Qloo response cache and full saved runs live (defaults: ./cache and ./golden)
QLOO_CACHE_DIR=
GOLDEN_DIR=

# ---- Optional: page ----
# Public repository, linked from the evidence panel
REPO_URL=

# ---- Research scripts only (not needed to run the app) ----
# backtest14.py (Ticketmaster bills)
TICKETMASTER_API_KEY=
# test8.py, backtest18.py (Gemini judge and small model)
GEMINI_API_KEY=
