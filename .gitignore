# =============================================================================
# Whitespace .gitignore
#
# Two rules this file enforces:
#   1. No API key or secret ever reaches the repository.
#   2. No Qloo response data reaches the repository. Qloo allows private
#      server-side caching, not Qloo data in a public repo. Public, redacted
#      replays live in fixtures/replays and ARE committed on purpose.
# =============================================================================

# ---- Secrets and local configuration ----------------------------------------
.env
.env.*
!.env.example
*.env
.envrc
*.pem
*.key
*.p12
*.pfx
secrets/
secrets.*
credentials.json
service-account*.json
.render/
.vercel/

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

